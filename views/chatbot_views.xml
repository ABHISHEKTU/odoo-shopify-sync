<odoo>
    <record id="view_shopify_chatbot_wizard_form" model="ir.ui.view">
        <field name="name">shopify.chatbot.wizard.form</field>
        <field name="model">shopify.chatbot.wizard</field>
        <field name="arch" type="xml">
            <form string="Ask Inventory Assistant">
                <group>
                    <field name="question" placeholder="e.g. How many Test Hoodie do we have? What was our last order?"/>
                </group>
                <footer>
                    <button name="action_ask" string="Ask" type="object" class="btn-primary"/>
                    <button string="Close" class="btn-secondary" special="cancel"/>
                </footer>
                <group invisible="not answer">
                    <field name="answer" readonly="1"/>
                </group>
            </form>
        </field>
    </record>

    <record id="action_shopify_chatbot_wizard" model="ir.actions.act_window">
        <field name="name">Ask Inventory Assistant</field>
        <field name="res_model">shopify.chatbot.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_shopify_chatbot"
        name="AI Assistant"
        action="action_shopify_chatbot_wizard"
        parent="stock.menu_stock_root"
        sequence="100"/>
</odoo>


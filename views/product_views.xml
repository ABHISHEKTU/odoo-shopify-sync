<odoo>
    <record id="view_product_template_form_shopify" model="ir.ui.view">
        <field name="name">product.template.form.shopify</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="before">
                <header>
                    <field name="sync_status" widget="badge"
                        decoration-success="sync_status == 'synced'"
                        decoration-danger="sync_status == 'error'"/>
                </header>
            </xpath>
        </field>
    </record>

    <record id="action_shopify_sync" model="ir.actions.server">
        <field name="name">Sync Products from Shopify</field>
        <field name="model_id" ref="product.model_product_template"/>
        <field name="binding_model_id" ref="product.model_product_template"/>
        <field name="state">code</field>
        <field name="code">records.action_sync_from_shopify() if records else model.action_sync_from_shopify()</field>
    </record>

    <record id="action_shopify_push" model="ir.actions.server">
        <field name="name">Push to Shopify</field>
        <field name="model_id" ref="product.model_product_template"/>
        <field name="binding_model_id" ref="product.model_product_template"/>
        <field name="state">code</field>
        <field name="code">records.action_push_to_shopify()</field>
    </record>
</odoo>

